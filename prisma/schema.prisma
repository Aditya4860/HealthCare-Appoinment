generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Role values: ADMIN | DOCTOR | PATIENT
// AppointmentStatus values: PENDING | CONFIRMED | CANCELLED | COMPLETED
// workingHours stored as JSON string: { "start": "09:00", "end": "17:00" }

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  /// Role: ADMIN | DOCTOR | PATIENT
  role      String   @default("PATIENT")
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  isActive       Boolean   @default(true)
  phone          String?
  dateOfBirth    DateTime?
  gender         String?
  bloodGroup     String?
  allergies      String?
  emergencyName  String?
  emergencyPhone String?
  address        String?

  doctorProfile      DoctorProfile?
  patientProfile     PatientProfile?
  appointments       Appointment[]  @relation("PatientAppointments")
  doctorAppointments Appointment[]  @relation("DoctorAppointments")
  notifications      Notification[]
  reminders          MedicationReminder[] @relation("PatientReminders")
  calendarToken      CalendarToken?
}

model DoctorProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialisation String
  slotDuration   Int      @default(30)
  /// JSON string: { "start": "HH:mm", "end": "HH:mm" }
  workingHours   String
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  leaves         DoctorLeave[]
}

model PatientProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth DateTime?
  phone       String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Appointment {
  id          String   @id @default(cuid())
  patientId   String
  doctorId    String
  patient     User     @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor      User     @relation("DoctorAppointments",  fields: [doctorId],  references: [id])
  scheduledAt DateTime
  /// AppointmentStatus: HOLD | PENDING | CONFIRMED | CANCELLED | COMPLETED
  status         String   @default("PENDING")
  notes          String?
  symptoms       String?
  patientSummary String?
  urgencyLevel   String?
  chiefConcern   String?
  aiQuestions    String?
  prescription   String?
  medications    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  reminders      MedicationReminder[]
  calEventPatient String?
  calEventDoctor  String?
}

model DoctorLeave {
  id              String        @id @default(cuid())
  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  date            DateTime
  createdAt       DateTime      @default(now())

  @@unique([doctorProfileId, date])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  subject   String
  body      String
  isRead      Boolean   @default(false)
  status      String    @default("PENDING") // PENDING | SENT | FAILED
  retryCount  Int       @default(0)
  nextRetryAt DateTime?
  createdAt   DateTime  @default(now())
}

model MedicationReminder {
  id            String      @id @default(cuid())
  patientId     String
  patient       User        @relation("PatientReminders", fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  medicine      String
  dose          String
  frequency     String
  startDate     DateTime?
  endDate       DateTime?
  nextReminderAt DateTime
  lastSentAt    DateTime?
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
}

model CalendarToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
